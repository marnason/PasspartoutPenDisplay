<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>PasspartoutPenDisplay</AssemblyName>
    <Description>Mirrors the Passpartout painting canvas and tool palette onto a second display</Description>
    <Version>0.2.0</Version>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- Game install; only used to pick up UnityEngine.UI.dll when present. CI falls back to NuGet. -->
    <GameDir Condition="'$(GameDir)' == ''">O:\SteamLibrary\steamapps\common\Passpartout</GameDir>
    <GameUI>$(GameDir)/Passpartout_Data/Managed/UnityEngine.UI.dll</GameUI>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2019.4.7" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(GameUI)')">
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameUI)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(GameUI)')">
    <PackageReference Include="Unity3D.UnityEngine.UI" Version="2018.3.5.1" IncludeAssets="compile" />
  </ItemGroup>

</Project>
